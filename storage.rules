rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function orderParticipant(orderId) {
      return signedIn()
        && (
          firestore.get(/databases/(default)/documents/orders/$(orderId)).data.clientId
            == request.auth.uid
          || firestore.get(/databases/(default)/documents/orders/$(orderId)).data.riderId
            == request.auth.uid
        );
    }

    match /chat/{orderId}/{fileName} {
      allow read: if orderParticipant(orderId);
      allow write: if orderParticipant(orderId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /orders/{orderId}/receipts/{fileName} {
      allow read: if orderParticipant(orderId);
      allow write: if orderParticipant(orderId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
